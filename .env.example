# 站点完整域名，必须 https:// 开头，用于 Origin 校验。
# HTTPS 由 Cloudflare 对外提供，容器只监听 127.0.0.1（见 README「Cloudflare Tunnel」）。
XGIFT_ORIGIN=https://xp.example.com

# 后台管理员密码，至少 32 字符。生成一个：openssl rand -base64 24
# 推荐改用 XGIFT_ADMIN_PASSWORD_FILE 指向一个 0600 文件，密码就不会出现在
# .env 和容器环境变量里。
XGIFT_ADMIN_PASSWORD=

# X 结账页使用的 Stripe 公钥（pk_live_ 开头）。这是公开密钥。
# 可以留空，之后在后台「设置」里填同样生效：这里填的值只在记录库还没有
# 该记录时写入，之后以后台设置的为准。
XGIFT_STRIPE_KEY=

# 宿主机监听端口，cloudflared 回源到 127.0.0.1:<这里>
XGIFT_PORT=8787

# 是否开放前台兑换
XGIFT_PAYMENTS_ENABLED=true

# 可选：Cloudflare Turnstile 人机验证，两项必须同时配置
# XGIFT_TURNSTILE_SITE_KEY=
# XGIFT_TURNSTILE_SECRET_FILE=/data/turnstile-secret
