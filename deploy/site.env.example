# 裸机部署环境变量。放到 /etc/xgift/site.env（0600），由 systemd EnvironmentFile 加载。

# 站点完整域名，必须 https:// 开头，用于 Origin 校验。不能带尾斜杠。
XGIFT_ORIGIN=https://xp.example.com

# 后台管理员密码，至少 32 字符。生成一个：openssl rand -base64 24
XGIFT_ADMIN_PASSWORD=

# X 结账页使用的 Stripe 公钥（pk_live_ 开头）。这是公开密钥。
XGIFT_STRIPE_KEY=

# 数据目录：保管库、站点库、保管库密码、随机后台路径都在这里
XGIFT_DATA_DIR=/var/lib/xgift

# 监听地址，默认仅回环；HTTPS 由宿主机反向代理提供
XGIFT_LISTEN=127.0.0.1:8787

# 是否开放前台兑换
XGIFT_PAYMENTS_ENABLED=true

# 可选：Cloudflare Turnstile 人机验证，两项必须同时配置
# XGIFT_TURNSTILE_SITE_KEY=
# XGIFT_TURNSTILE_SECRET_FILE=/etc/xgift/turnstile-secret

# 以下仅在需要覆盖默认值时使用
# XGIFT_ALLOW_PUBLIC_LISTEN=true
# XGIFT_PASSWORD_FILE=/var/lib/xgift/vault-password
# XGIFT_ADMIN_PASSWORD_FILE=/etc/xgift/admin-password
